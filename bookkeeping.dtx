  \JE@setDebit{#3}{#4}%
  \JE@setCredit{#5}{#4}%
  \JE@setDescription{#6}{\iftrue}%
  \csgdef{JE\the\c@JECount @Line}{3}%
  \ledger@entry{#3}{#5}{D}{#4}%
  \ledger@entry{#5}{#3}{C}{#4}%
}
