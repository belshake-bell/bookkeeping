%    \begin{macrocode}
\def\TB@printTable{%
%<dbg>\typeout{Start  : TB@printTable}%
  \begin{table}[ht]\centering
  \begin{tabular}{rrcrr}
    \TB@printTableHeader
    \TB@Table@Loop
    \hline
    \TB@printTable@sumAccType
    \hline
    \TB@printline{\the\BKtemp@countA}{\the\BKtemp@countB}%
                 {合計}%
                 {\the\BKtemp@countC}{\the\BKtemp@countD}\hline%
  \end{tabular}
  \end{table}
  \clearpage
  \TB@Loop
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\TB@Loop}\par
% \changes{v1.1.0}{2025/04/07}
%   {カウンタ条件式周りの調整（\cmd{\c@Iterator@Account@Month}を回して
%    =14となるときを排除する）．}%
% \changes{v1.1.2-alpha.12}{2025/12/18}
%   {イテレータ用カウンタの命名変更による修正．}^^A
% 月についてイテレータ\cmd{\c@Iterator@Account@Month}を回して，
% 各月ごとの残高試算表の出力処理を行う．
%    \begin{macrocode}
\def\TB@Loop{%
  \ifnum\c@Iterator@Account@Month<\numexpr\c@ClosingMonthCount-1\relax
%<dbg>\typeout{Start  : TB@Loop}%
    \stepcounter{Iterator@Account@Month}%
%<dbg>\typeout{Ire.   : Iterator.Account.Month=\theIterator@Account@Month .}%
    \BKtemp@countA\z@ \BKtemp@countB\z@
    \BKtemp@countC\z@ \BKtemp@countD\z@
    \expandafter\subsection\expandafter{\the\c@Iterator@Account@Month 月}%
    \setcounter{Iterator@AccTypeID}{0}%
    \expandafter\TB@printTable
  \fi
}
%    \end{macrocode}
% \end{macro}
