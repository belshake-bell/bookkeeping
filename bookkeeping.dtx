%<dbg>\typeout{Start  :\noexpand\PJ@Loop .}%
  \begin{table}[ht]\centering
  \begin{tabular}{r|D{/}{/}{2/2}|lr|r|r|r}
    \makebox[2\zw]{ID}%
    & \multicolumn{1}{c|}{date}%
    & \makebox[10\zw][c]{摘}
