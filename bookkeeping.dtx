%  \meta{JEID}と欲しい\meta{prop.}から\meta{prop.}の値を得る．
%    \begin{macrocode}
\def\JE@getpropertySmpl#1#2{%
  \@ifundefined{JE#1@#2}{%
    \ifnum #1>\c@JECount
      \PackageError{bookkeeping}{%
        The JEID "#1" is over the number registered.
      }{%
        please tell package author.\MessageBreak
      }%
    \else
      \PackageError{bookkeeping}{%
        The property "#2" is not defined.
      }{%
        please tell package author.\MessageBreak
      }%
    \fi
  }{%
    \csuse{JE#1@#2}%
  }%
}
%    \end{macrocode}
% \end{macro}
