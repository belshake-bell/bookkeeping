% \end{macro}
% \begin{macro}{\PGL@L@@p}\marg{AccountID}\marg{AccType}\par
% \changes{v1.1.0}{2024/02/27}
%   {Account Typeを一時的に保持するマクロの名前をよりユニークな名前に変更．}
% \changes{v1.1.0}{2024/02/27}
%   {勘定科目の種類についてリファクタしたのに伴ってアクセス用のCSを変更．}
% \changes{v1.1.2-alpha.11}{2025/12/17}
%   {\cs{csname}\cs{endcsname}から\cs{csuse}に変更．}^^A
% \changes{v1.1.2-alpha.12}{2025/12/18}
%   {イテレータ用カウンタの命名変更による修正．}^^A
% \changes{v1.1.2-alpha.19.01}{2025/12/21}
%   {\cs{PGL@ACLoop}の引数の取り方を変更する予定があるので準備．}^^A
% \changes{v1.1.2-alpha.19.04}{2025/12/22}
%   {\cs{PGL@Loop}の引数の取り方を変更したのに合わせて修正．}^^A
% \changes{v1.1.2-alpha.19.04}{2025/12/22}
%   {\cs{PGL@L@@p}の引数の取り方を変更．}^^A
% ある勘定科目の種類に属する各勘定科目について\cmd{\PLG@ACLoop}を呼び出す．
% 全ての勘定科目について呼び出したら\cmd{\PLG@Loop}に処理を戻す．
%    \begin{macrocode}
\def\PGL@L@@p#1#2{%
  \ifnum\c@Iterator@AccountID<\csuse{c@AccType\PGL@tmp@AccType @AccountCount}%
    \stepcounter{Iterator@AccountID}%
    \expandafter\subsection\expandafter%
      {\csuse{Account\PGL@tmp@AccType\the\c@Iterator@AccountID @Name}}%
    \setcounter{Iterator@Account@LEID}{0}%
    \setcounter{LedgerEntryBalance}{0}%
    \global\sum@debit\z@\relax\global\sum@credit\z@\relax
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi{\PGL@ACLoop}{\PGL@Loop{}}%
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\PGL@Loop}\marg{AccTypeID}\par
% \changes{v1.1.0}{2024/02/27}
%   {勘定科目の種類についてリファクタしたのに伴ってアクセス用のマクロを変更．}
% \changes{v1.1.0}{2024/02/27}
%   {Account Typeを一時的に保持するマクロの名前をよりユニークな名前に変更．}
% \changes{v1.1.2-alpha.12}{2025/12/18}
%   {イテレータ用カウンタの命名変更による修正．}^^A
% \changes{v1.1.2-alpha.19.04}{2025/12/22}
%   {\cs{PGL@Loop}の引数の取り方を変更．}^^A
% \changes{v1.1.2-alpha.19.04}{2025/12/22}
%   {\cs{PGL@L@@p}の引数の取り方を変更したのに合わせて修正．}^^A
% 各勘定科目の種類について\cmd{\PLG@L@@p}を呼び出す．
%    \begin{macrocode}
\def\PGL@Loop#1{%
  \ifnum\c@Iterator@AccTypeID<\c@AccountTypeCount\relax
    \stepcounter{Iterator@AccTypeID}%
    \xdef\PGL@tmp@AccType{\AccType@getAccType{\the\c@Iterator@AccTypeID}}%
    \setcounter{Iterator@AccountID}{0}%
    \expandafter\@firstofone
  \else
    \expandafter\@gobble
  \fi{\PGL@L@@p{}{}}%
}
%    \end{macrocode}
% \end{macro}
