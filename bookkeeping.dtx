% \begin{macro}{\PJ@Loop@Table}%
% \changes{v1.1.2-alpha.12}{2025/12/18}
%   {イテレータ用カウンタの命名変更による修正．}^^A
% 仕訳帳の表の内容を出力する．
%    \begin{macrocode}
\def\PJ@Loop@Table{%
%<dbg>\typeout{Start  :\noexpand\PJ@Loop@Table .}%
%<dbg>\typeout{nest.if:\the\currentiflevel .}%
  \gdef\n@xt{}%
%    \end{macrocode}
% 取引をすべて出力したなら仕訳帳を締め切る処理をする．
%    \begin{macrocode}
  \ifnum\c@Iterator@JEID>\numexpr\c@JECount-1\relax
%<dbg>\typeout{Process:Terminate.}%
%<dbg>\typeout{Status :cnt.Iterator@JEID=\theIterator@JEID .}%
    \PJ@Terminate
%    \end{macrocode}
% 現在の仕訳帳の行数が1ページ当たりの最大行数
% \cmd{\maxtablelinenumber}以上であるならば，
% 次頁繰越の処理をする．
%    \begin{macrocode}
  \else
    \ifnum\c@tableLineCount>\numexpr\maxtablelinenumber-1\relax
%<dbg>\typeout{Process:CarryForward.}%
      \gdef\n@xt{\PJ@Loop}%
      \gdef\n@xtprev{\PJ@CarryPrev}%
      \PJ@CarryForward
%    \end{macrocode}
% \cntname{Iterator@JEID}を進めて，それを取引IDとする取引について処理をする：
% \begin{enumerate}
%   \item 行数をカウントし，
%   \item \cmd{\sum@debit}カウンタおよび\cmd{\sum@credit}カウンタに
%         借方および貸方金額を加算し
%   \item 取引を出力し，
%   \item 再帰する．
% \end{enumerate}
% \changes{v1.1.2-alpha.11}{2025/12/17}
%   {不要なコメント行を削除．}^^A
% \changes{v1.1.2-alpha.17}{2025/12/19}
%   {\cs{csuse}からGetterに変更．}^^A
% \changes{v1.1.2-alpha.17.01}{2025/12/19}
%   {FIX: \cs{expandafter}と\cs{fi}の数の整合性．}^^A
%    \begin{macrocode}
    \else
%<dbg>\typeout{Process:Transaction.}%
      \refstepcounter{Iterator@JEID}%
      \global\advance\c@tableLineCount
        \JE@getpropertySmpl{\the\c@Iterator@JEID}{Line}\relax
      \global\advance\sum@debit
        \JE@getpropertySmpl{\the\c@Iterator@JEID}{Debit@Value}\relax
      \global\advance\sum@credit
        \JE@getpropertySmpl{\the\c@Iterator@JEID}{Credit@Value}\relax
%<dbg>\typeout{Status :cnt.Iterator@JEID=\theIterator@JEID .}%
%<dbg>\typeout{Status :cnt.tableLineCount=\thetableLineCount .}%
%<dbg>\typeout{Status :cnt.sum@debit=\the\sum@debit .}%
%<dbg>\typeout{Status :cnt.sum@credit=\the\sum@credit .}%
      \PJ@Transaction{\the\c@Iterator@JEID}%
      \expandafter\expandafter\expandafter\PJ@Loop@Table
    \fi
  \fi
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\PJ@Loop}%
