% \begin{macro}{\PGL@ACLoop@Table}\jmarg{勘定科目名}\par
% \changes{v1.1.0}{2024/02/27}
%   {Account Typeを一時的に保持するマクロの名前をよりユニークな名前に変更．}
% \changes{v1.1.2-alpha.12}{2025/12/18}
%   {イテレータ用カウンタの命名変更による修正．}^^A
% \changes{v1.1.2-alpha.18}{2025/12/19}
%   {\cs{PGL@Transaction}の引数の取り方を変更したのに合わせて修正．}^^A
% \changes{v1.1.2-alpha.19.01}{2025/12/21}
%   {引数で勘定科目名を取るように変更．}^^A
% \changes{v1.1.2-alpha.19.03}{2025/12/22}
%   {\cs{PGL@Terminate}の引数の取り方を変更したのに合わせて修正．}^^A
% \changes{v1.1.2-alpha.19.04}{2025/12/22}
%   {\cs{PGL@L@@p}の引数の取り方を変更したのに合わせて修正．}^^A
% ある勘定科目の各仕訳について\cmd{\PGL@Transaction}を呼び出す．
% 全ての仕訳を出力したら\cmd{\PGL@Terminate}を呼び出す．
% その他改ページ処理など．
%    \begin{macrocode}
\def\PGL@ACLoop@Table#1{%
  \ifnum\c@Iterator@Account@LEID>\numexpr\Account@getpropertySmpl{#1}{LedgerCount}-1\relax
    \hline
    \PGL@Terminate{#1}%
    \expandafter\@gobble
  \else
    \ifnum\c@tableLineCount>\numexpr\maxtablelinenumber-1\relax
      \hline
      \gdef\n@xt{\PGL@ACLoop}%
      \gdef\n@xtprev{\PGL@CarryPrev}%
      \PGL@CarryForward
      \expandafter\expandafter\expandafter\@gobble
    \else
      \gdef\n@xt{\PGL@L@@p{}{}}%
      \stepcounter{Iterator@Account@LEID}%
      \ifnum\Account@getpropertySmpl{#1}{Ledger\the\c@Iterator@Account@LEID @AccountValue}=0\relax
        \stepcounter{tableLineCount}%
        \PGL@MonthlyClosing%
      \else
        \stepcounter{tableLineCount}%
        \PGL@Transaction{\the\c@Iterator@Account@LEID}%
          {\Account@getNameFromId{\PGL@tmp@AccType}{\the\c@Iterator@AccountID}}%
      \fi
      \expandafter\expandafter\expandafter\@firstofone
    \fi
  \fi{\PGL@ACLoop@Table{#1}}%
}
%    \end{macrocode}
% \end{macro}
