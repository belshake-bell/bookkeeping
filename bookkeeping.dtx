%    貸方残高\cntname{Credit}を新設．}^^A
% 勘定科目を登録する．
% \TODO{\cmd{\registerAccount}で良くない？}
%    \begin{macrocode}
%% registerAccountID: 勘定科目の登録
%% #1: Account type
%% #2: Account Ledger Balance (Debit(D) or Credit(C) or Auto(A))
%% #3: Account Name
\newcommand{\registerAccountID}[3]{%
  \global\advance\csuse{c@AccType#1@AccountCount}\@ne\relax%
  \csgdef{revAccount#3@Type}{#1}% AccType <- Account Name
  \csxdef{revAccount#3@ID}%
    {\the\csuse{c@AccType#1@AccountCount}}% ID <- Account Name
  \Account@setpropertySmpl{#3}{Name}{#3}%
  \Account@setpropertySmpl{#3}{LedgerCount}{0}%
  \Account@setpropertySmpl{#3}{LedgerBalanceType}{#2}%
  \Account@setpropertySmpl{#3}{Balance}{0}%
  \Account@setpropertySmpl{#3}{Debit}{0}%
  \Account@setpropertySmpl{#3}{Credit}{0}%
%<dbg>\typeout{Start  : \unexpanded{\registerAccountID}.}%
%<dbg>\typeout{AccType: #1}%
%<dbg>\typeout{AccID  : \the\csuse{c@AccType#1@AccountCount}}%
%<dbg>\typeout{Account[#3].Name: %
%<dbg>         \Account@getpropertySmpl{#3}{Name}}%
%<dbg>\typeout{Account[#3].LedgerCount: %
%<dbg>         \Account@getpropertySmpl{#3}{LedgerCount}}%
%<dbg>\typeout{Account[#3].LedgerBalanceType: %
%<dbg>         \Account@getpropertySmpl{#3}{LedgerBalanceType}}%
  \Account@init@Month{0}{#3}%
%<dbg>\typeout{Finish : \unexpanded{\registerAccountID}.}%
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\Account@init@Month}\marg{init~month}\marg{Account~Name}\par
% \changes{v1.1.2-alpha.08}{2025/12/15}
%   {Accountのsetterを使用．}^^A
% \changes{v1.1.2-alpha.17}{2025/12/19}
%   {Rename from \cs{register@Acc@Mon@Bal}．}^^A
% 勘定科目の月ごとの残高・借方合計・貸方合計の初期化．
%    \begin{macrocode}
\def\Account@init@Month#1#2{%
  \ifnum#1>\BK@closingmonth\relax
%<dbg>\typeout{Process: End of init Account[#2].Month}%
    \expandafter\@gobble%
  \else
%<dbg>\typeout{Process: Init Account[#2].Month[#1]}%
    \Account@setpropertySmpl{#2}{Month#1@Balance}{0}%
    \Account@setpropertySmpl{#2}{Month#1@Debit}{0}%
    \Account@setpropertySmpl{#2}{Month#1@Credit}{0}%
    \expandafter\@firstofone%
  \fi
  {%
    \expandafter\Account@init@Month\expandafter
      {\expanded{\the\numexpr#1+1\relax}}{#2}%
  }%
}
%    \end{macrocode}
% \end{macro}
