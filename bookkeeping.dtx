% \begin{macro}{\TB@Table@Acc@OneLine@BalanceDebt}%
% \changes{v1.1.0}{2025/02/05}
%   {残高額を表示するかどうかも含めて別マクロに切り離す．}%
% 合計残高試算表にて借方残高を表示するマクロ．
%    \begin{macrocode}
\def\TB@Table@Acc@OneLine@BalanceDebt{%
  \if\Acc@LedgBalType D%
    \csuse{\TB@tmp@AccTT@ThisMonth @Balance}%
    \global\advance\BKtemp@countA
                   \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
    \csxdef{\TB@tmp@AccT@ThisMonth @sumDebit}{%
      \the\numexpr\csuse{\TB@tmp@AccT@ThisMonth @sumDebit}%
      + \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
    }%
  \fi
  \if\Acc@LedgBalType A%
    \ifnum\csuse{\TB@tmp@AccTT@ThisMonth @Balance}<0\relax
      \the\numexpr-\csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
      \global\advance\BKtemp@countA
                    -\csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
      \csxdef{\TB@tmp@AccT@ThisMonth @sumDebit}{%
        \the\numexpr\csuse{\TB@tmp@AccT@ThisMonth @sumDebit}%
        - \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
      }%
    \fi
  \fi
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\TB@Table@Acc@OneLine@BalanceCredit}%
% \changes{v1.1.0}{2025/02/05}
%   {残高額を表示するかどうかも含めて別マクロに切り離す．}%
% 合計残高試算表にて貸方残高を表示するマクロ．
%    \begin{macrocode}
\def\TB@Table@Acc@OneLine@BalanceCredit{%
  \if\Acc@LedgBalType C%
    \csuse{\TB@tmp@AccTT@ThisMonth @Balance}%
    \global\advance\BKtemp@countD
                   \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
    \csxdef{\TB@tmp@AccT@ThisMonth @sumCredit}{%
      \the\numexpr\csuse{\TB@tmp@AccT@ThisMonth @sumCredit}%
      + \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
    }%
  \fi
  \if\Acc@LedgBalType A%
    \ifnum\csuse{\TB@tmp@AccTT@ThisMonth @Balance}<0\relax\else
      \the\numexpr\csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
      \global\advance\BKtemp@countA
                     \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
      \csxdef{\TB@tmp@AccT@ThisMonth @sumDebit}{%
        \the\numexpr\csuse{\TB@tmp@AccT@ThisMonth @sumDebit}%
          \csuse{\TB@tmp@AccTT@ThisMonth @Balance}\relax
      }%
    \fi
  \fi
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\TB@Table@Acc@OneLine}%
% \changes{v1.1.0}{2024/02/27}
%   {Account Typeを一時的に保持するマクロの名前をよりユニークな名前に変更．}%
% \changes{v1.1.0}{2025/02/05}
%   {Account Typeを一時的に保持するマクロの名前を再変更．}%
% \changes{v1.1.0}{2025/02/05}
%   {勘定科目の種類に残高を自動判定するA(Auto)を追加したのに合わせて
%    残高表示を別マクロ化．}%
% \changes{v1.1.0}{2025/02/05}
%   {合計残高試算表の各マクロ名をもう少し分かりやすく変更．}%
% 合計残高試算表の1行出力．
%    \begin{macrocode}
\def\TB@Table@Acc@OneLine{%
  \xdef\reserved@a{\TB@tmp@AccType\the\c@AccountIDiterator}%
  \xdef\TB@tmp@AccTT@ThisMonth{Account\reserved@a @Month\the\c@MonthIterator}%
  \xdef\TB@tmp@AccT@ThisMonth{Account\TB@tmp@AccType @Month\the\c@MonthIterator}%
  \xdef\Acc@LedgBalType{%
    \csname Account\reserved@a @LedgerBalanceType\endcsname}%
  \TB@printline{% Debt balance
    \TB@Table@Acc@OneLine@BalanceDebt
  }{%
    \csuse{\TB@tmp@AccTT@ThisMonth @Debit}%
    \global\advance\BKtemp@countB
                   \csuse{\TB@tmp@AccTT@ThisMonth @Debit}\relax
    \csxdef{\TB@tmp@AccT@ThisMonth @Debit}{%
      \the\numexpr\csuse{\TB@tmp@AccT@ThisMonth @Debit}%
      + \csuse{\TB@tmp@AccTT@ThisMonth @Debit}\relax
    }%
  }{%
    \csuse{Account\reserved@a @Name}%
  }{%
    \csuse{\TB@tmp@AccTT@ThisMonth @Credit}%
    \global\advance\BKtemp@countC
                   \csuse{\TB@tmp@AccTT@ThisMonth @Credit}\relax
    \csxdef{\TB@tmp@AccT@ThisMonth @Credit}{%
      \the\numexpr\csuse{\TB@tmp@AccT@ThisMonth @Credit}%
      + \csuse{\TB@tmp@AccTT@ThisMonth @Credit}\relax
    }%
  }{%
    \TB@Table@Acc@OneLine@BalanceCredit
  }%
}
%    \end{macrocode}
% \end{macro}
