% \marg{\cntname{Month}\meta{month}\cntname{@Credit}}でアクセスできる．
%    \begin{macrocode}
\def\TB@Table@Acc@OneLine{%
%<dbg>\typeout{Start  : TB@Table@Acc@OneLine}%
  \xdef\reserved@a{\TB@tmp@AccType\the\c@Iterator@AccountID}%
  \xdef\TB@tmp@AccTT@ThisMonth{Account\reserved@a @Month\the\c@Iterator@Account@Month}%
  \xdef\TB@tmp@AccT@ThisMonth{Account\TB@tmp@AccType @Month\the\c@Iterator@Account@Month}%
  \xdef\Acc@LedgBalType{%
    \csuse{Account\reserved@a @LedgerBalanceType}}%
