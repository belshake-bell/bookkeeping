% 勘定科目名が\meta{Account~Name}の\meta{AccLdgID}の取引を出力する．
% \TODO{長いし分割した方がいい．}
% \TODO{2番目の引数を使うように変更する．}
%    \begin{macrocode}
%% #1: ladger entry ID
%% #2: Account Name
\def\PGL@Transaction#1#2{%
%<dbg>\typeout{Start  : \unexpanded{\PGL@Transaction}.}%
%<dbg>\typeout{  Param: ladger entry ID #1.}%
%<dbg>\typeout{  Param: Account Name #2.}%
  \PGL@printline{% FullLEID: Account[Name].Ledger[LEID].FullLEID
%<dbg>\typeout{Process: Account[Name].Ledger[LEID].FullLEID.}%
    \Account@getpropertySmpl{#2}{Ledger#1@FullLEID}%
    \label{LEID:\Account@getpropertySmpl{#2}{Ledger#1@FullLEID}}%
  }{% Month/Day: JE.getDate(Account[Name].Ledger[LEID].JEID)
%<dbg>\typeout{Process: Month/Day.}%
    \printJE@Date{\Account@getpropertySmpl{#2}{Ledger#1@JEID}}%
  }{% Partner Account title: Account[Name].Ledger[LEID].PartnerAccount
%<dbg>\typeout{Process: Account[Name].Ledger[LEID].PartnerAccount.}%
    \Account@getpropertySmpl{#2}{Ledger#1@PartnerAccount}%
  }{% Desc.: Account[Name].Ledger[LEID].JEDesc
%<dbg>\typeout{Process: Account[Name].Ledger[LEID].JEDesc.}%
    \Account@getpropertySmpl{#2}{Ledger#1@JEDesc}%
  }{% JEID: Account[Name].Ledger[LEID].JEID
%<dbg>\typeout{Process: Account[Name].Ledger[LEID].JEID.}%
    \hyperref[JEID:\Account@getpropertySmpl{#2}{Ledger#1@JEID}]%
      {\Account@getpropertySmpl{#2}{Ledger#1@JEID}}%
  }{% Debit: 条件分けして Account[Name].Ledger[LEID].AccountValue
%<dbg>\typeout{Process: Debit; Account[Name].Ledger[LEID].AccountValue.}%
    \if\Account@getpropertySmpl{#2}{Ledger#1@IsAccountDebit}D\relax%
      \Account@getpropertySmpl{#2}{Ledger#1@AccountValue}%
      \global\advance\sum@debit
                     \Account@getpropertySmpl{#2}{Ledger#1@AccountValue}\relax
    \fi
  }{% Credit: 条件分けして Account[Name].Ledger[LEID].AccountValue
%<dbg>\typeout{Process: Credit; Account[Name].Ledger[LEID].AccountValue.}%
    \if\Account@getpropertySmpl{#2}{Ledger#1@IsAccountDebit}C\relax%
      \Account@getpropertySmpl{#2}{Ledger#1@AccountValue}%
      \global\advance\sum@credit
                     \Account@getpropertySmpl{#2}{Ledger#1@AccountValue}\relax
    \fi
  }{% Balance type: Account[Name].LedgerBalanceTypeで条件分け
%<dbg>\typeout{Process: Account[Name].LedgerBalanceType.}%
    \Account@swBalanceType{#2}{%
      借
    }{%
      貸
    }{%
      \ifnum\Account@getpropertySmpl{#2}{Ledger#1@AccountBalance}>\z@
        借
      \else
        貸
      \fi
    }%
  }{% Balance: Account[Name].Balance
%<dbg>\typeout{Process: Account[Name].Ledger[LEID].Balance.}%
    \Account@getLedgerBalance{#2}{#1}%
  }%
}
