% \begin{macro}{\ledger@entry}\jmarg{勘定科目名}%
%                             \jmarg{相手科目名}%
%                             \jmarg{借（貸）方}%
%                             \jmarg{取引額}\par
% \cntname{\cmd{\Account}\meta{AccType}\meta{AccID}@Ledger\meta{AccLdgID}@\meta{prop.}}に
% 各種値を代入していく．
% そのほか\cntname{\cmd{\Account}\meta{AccType}\meta{AccID}@Month\meta{Month}@\meta{prop.}}に
