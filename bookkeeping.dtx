% \subsubsection{月次締切}\label{ss:月次締切}%
% \begin{macro}{\ledgermonthlyclosing}\jmarg{締切月}\par
% 月次締切用コマンド．
% 各\meta{AccType}および各\meta{AccID}についてイテレータ
% \cmd{\BKtemp@countD}および\cmd{\BKtemp@countC}を用いてループを回す．
%    \begin{macrocode}
\newcommand{\ledgermonthlyclosing}[1]{% #1: closing month
  \BKtemp@countC\z@\relax
  \BKtemp@countD\z@\relax
  \stepcounter{ClosingMonthCount}%
  \gdef\LMC@month{#1}%
  \LMC@loop
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\LMC@loop}\par
% \changes{v1.1.0}{2024/02/27}
%   {勘定科目の種類についてリファクタしたのに伴ってアクセス用のマクロを変更．}
% \meta{AccType}を\cmd{\BKtemp@countD}でイテレーション，\cmd{\BKtemp@countC}を
% クリアして\cmd{\LMC@l@@p}を呼び出す．
%    \begin{macrocode}
\def\LMC@loop{% loop for each AccType
  \ifnum\the\BKtemp@countD<\c@AccountTypeCount\relax
    \global\advance\BKtemp@countD\@ne
    \global\BKtemp@countC\z@\relax
    \xdef\LMC@AccType{\AccType@getAccType{\the\BKtemp@countD}}%
    % \LMC@AccType <- AccType
    \expandafter\LMC@l@@p
  \fi
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\LMC@l@@p}\par
% \changes{v1.1.0}{2024/02/27}
%   {勘定科目の種類についてリファクタしたのに伴ってアクセス用のCSを変更．}
% \changes{v1.1.2-alpha.11}{2025/12/17}
%   {\cs{csname}\cs{endcsname}から\cs{csuse}に変更．}^^A
% \meta{Account}を\cmd{\BKtemp@countC}でイテレーション．
%    \begin{macrocode}
\def\LMC@l@@p{% loop for each AccID
  \ifnum\BKtemp@countC<\csuse{c@AccType\LMC@AccType @AccountCount}%
    \global\advance\BKtemp@countC\@ne
    \xdef\reserved@a{\csuse{Account\LMC@AccType\the\BKtemp@countC @Name}}%
    \expandafter\ledger@entry\expandafter{\reserved@a}{\LMC@month}{\relax}{0}%
    \expandafter\LMC@l@@p
  \else
    \expandafter\LMC@loop
  \fi
}
%    \end{macrocode}
