% \changes{v1.1.0}{2025/02/05}
%   {勘定科目の種類に残高を自動判定するA(Auto)を追加したのに合わせて
%    残高表示を別マクロ化．}%
% \changes{v1.1.2-alpha.12}{2025/12/18}%
%   {イテレータ用カウンタの命名変更による修正．}^^A
% \changes{v1.1.2-alpha.19}{2025/12/21}%
%   {\cs{csuse}をGetterに変更．}^^A
% \changes{v1.1.2-alpha.19.06}{2025/12/22}%
