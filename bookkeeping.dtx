\newcommand{\sjourn@lentry}[5]{%
  \stepcounter{JECount}%
  \JE@setDate{#1}{#2}%
  \JE@setDebit{#3}{#4}%
  \JE@setCredit{#5}{#4}%
  \JE@setDescription{}{\iffalse}%
  \csgdef{JE\the\c@JECount @Line}{2}%
  \ledger@entry{#3}{#5}{D}{#4}%
  \ledger@entry{#5}{#3}{C}{#4}%
}
