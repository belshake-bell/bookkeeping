% 1ページの出力が終わったなら改ページをして仕訳表の行数をゼロに戻す．
%    \begin{macrocode}
  \clearpage
  \global\c@tableLineCount\z@\relax
%    \end{macrocode}
% 次頁繰越をしたときには\cmd{\n@xt}はこのマクロへの再帰処理が定義されている；
% それ以外の時，つまり仕訳帳を締め切ったときには空．
%    \begin{macrocode}
  \n@xt
}
