% Account
\iffalse
勘定科目および勘定科目の種類．

勘定科目の種類IDが<AccTypeID>のとき
* AccountType@
* BK@AccType<AccTypeID>: <AccType>を得る．
* AccountNumber<AccType>カウンタ: 勘定科目の種類が<AccType>の勘定科目の総登録数を得る．

勘定科目IDを<AccType><AccID>と表すことにする．
* Account<AccType><AccID>@Name: 勘定科目名を得る．
* Account<AccType><AccID>@LedgerNumber: 勘定科目に登録された取引登録数．この数字でイテレータの分岐をさせる．
* Account<AccType><AccID>@LedgerBalanceType: 勘定科目が借方残高(D)か貸方残高(C)か．
* Account<AccType><AccID>@Month<month>@Balance: 月ごとの残高．
* Account<AccType><AccID>@Month<month>@Debit: 月ごとの借方合計．
* Account<AccType><AccID>@Month<month>@Credit: 月ごとの貸方合計．

* revAccountID<勘定科目名>: 勘定科目名から<AccID>を得る
* revAccountType<勘定科目名>: 勘定科目名から<AccType>を得る
* \Account@getAccID{<勘定科目名>}: 勘定科目名から<AccID>を得る
* \Account@getAccType{<勘定科目名>}: 勘定科目名から<AccType>を得る
* \Account@getAccTypeAccID{<勘定科目名>}: 勘定科目名から<AccType><AccID>を得る

0月は開始仕訳用，13月は閉鎖用．
\fi

% registerAccType: 勘定科目の種類の登録
% #1: Account type name
\def\registerAccType#1{%
  \stepcounter{AccountTypeNumber}%
  \csdef{BK@AccType\the\c@AccountTypeNumber}{#1}%
  \newcounter{AccountNumber#1}%
}
\registerAccType{A}% 資産 (Asset)
\registerAccType{L}% 負債 (Liability)
\registerAccType{N}% 総資産 (Net asset)
\registerAccType{R}% 収益 (Revenue)
\registerAccType{E}% 費用 (Expence)
\registerAccType{M}% その他 (Misc.)

% registerAccountID: 勘定科目の登録
% #1: Account type
% #2: Account Ledger Balance (Debit(D) or Credit(C))
% #3: Account Name
\def\registerAccountID#1#2#3{%
  \global\advance\csuse{c@AccountNumber#1}\@ne\relax%
  \csxdef{revAccountID#3}{\the\csname c@AccountNumber#1\endcsname}% ID <- Account Name
  \csgdef{revAccountType#3}{#1}% AccType <- Account Name
  \csgdef{Account#1\the\csname c@AccountNumber#1\endcsname @Name}{#3}%
  \csgdef{Account#1\the\csname c@AccountNumber#1\endcsname @LedgerNumber}{0}%
  \csgdef{Account#1\the\csname c@AccountNumber#1\endcsname @LedgerBalanceType}{#2}%
  \BKtemp@countA=-1\relax
  \edef\reserved@a{#1\the\csuse{c@AccountNumber#1}}%
  \register@Acc@Mon@Bal
% \typeout{<AccType>: #1\par <AccID>: \the\csuse{c@AccountNumber#1}}%
}
% \register@Acc@Mon@Bal: 勘定科目の月ごとの残高・借方合計・貸方合計の登録
\def\register@Acc@Mon@Bal{%
  \ifnum\BKtemp@countA<\BK@closingmonth
    \global\advance\BKtemp@countA\@ne\relax
    \csxdef{Account\reserved@a @Month\the\BKtemp@countA @Balance}{0}%
    \csxdef{Account\reserved@a @Month\the\BKtemp@countA @Debit}{0}%
    \csxdef{Account\reserved@a @Month\the\BKtemp@countA @Credit}{0}%
    \expandafter\register@Acc@Mon@Bal
  \fi
}
\def\Account@getAccID#1{\csuse{revAccountID#1}}
\def\Account@getAccType#1{\csuse{revAccountType#1}}
\def\Account@getAccTypeAccID#1{\Account@getAccType{#1}\Account@getAccID{#1}}

\def\selectAccount#1#2{%
  \edef\currAccount@Type{\expandonce{\csname Account#1#2@Type\endcsname}}%
  \edef\currAccount@Name{\expandonce{\csname Account#1#2@Name\endcsname}}%
  \edef\currAccount@LedgerNumber{\expandonce{\csname Account#1#2@LedgerNumber\endcsname}}%
  \edef\currAccount@LedgerBalanceType{\expandonce{\csname Account#1#2@LedgerBalanceType\endcsname}}%
}
